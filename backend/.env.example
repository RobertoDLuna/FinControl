# Aplicação
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Banco de Dados PostgreSQL
# Utilize DATABASE_URL ou preencha as variáveis individuais abaixo
DATABASE_URL=postgresql://DB_USER:CHANGE_ME@localhost:5432/fincontrol
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fincontrol
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
